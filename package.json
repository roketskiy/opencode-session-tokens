{
  "name": "opencode-session-tokens",
  "version": "0.1.0",
  "description": "OpenCode 插件：在 TUI 底部常驻一条当前会话的 token 用量统计（含缓存命中率）",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "engines": {
    "opencode": ">=1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/tui.tsx --outdir ./dist --target bun --external solid-js --external \"solid-js/*\" --external \"@opentui/*\" --external \"@opencode-ai/*\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test/smoke.ts"
  },
  "peerDependencies": {
    "@opentui/solid": "0.5.4",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/solid": "0.5.4",
    "solid-js": "1.9.12",
    "typescript": "^5.6.0"
  }
}